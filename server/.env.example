# ===== Oficial Link ERP — configuração =====
# Copie este arquivo para .env e ajuste os valores.

# Porta do servidor
PORT=3000

# Ambiente: production | development | test
NODE_ENV=development

# Enviar cookies apenas via HTTPS (obrigatório em produção; ativa HSTS)
SECURE_COOKIES=0

# Tempo de sessão em horas
SESSION_TTL_HOURS=8

# Caminho do banco de dados SQLite.
# SEMPRE resolvido a partir da RAIZ DO PROJETO (a pasta oficial-link-erp/):
#   padrão  → <raiz>/data/erp.db
#   testes  → sobrescreva DB_FILE com um arquivo temporário ANTES de importar o app
DB_FILE=./data/erp.db

# ---- Segurança de produção ----

# Proxy reverso confiável para identificar o IP real (rate limit/auditoria).
# SOMENTE lido do ambiente — nunca aceito de valor enviado pelo cliente.
#   não definido + production → X-Forwarded-For é IGNORADO (direto na internet)
#   TRUST_PROXY=1             → confia no 1º proxy (ex.: nginx local)
#   TRUST_PROXY=loopback      → confia em proxies loopback
#TRUST_PROXY=1

# Origem pública do ERP (produção). A proteção CSRF aceita APENAS esta origem,
# comparando a ORIGEM COMPLETA: protocolo + host + porta.
#   APP_ORIGIN=https://erp.oficiallink.com
#     → aceita  https://erp.oficiallink.com
#     → bloqueia http://erp.oficiallink.com (protocolo diferente)
#     → bloqueia https://erp.oficiallink.com:8443 (porta diferente)
#     → bloqueia https://outrodominio.com (host diferente)
# Em desenvolvimento/teste, NÃO defina — localhost segue funcionando.
#APP_ORIGIN=https://erp.oficiallink.com

# ---- Seed (somente INSTALAÇÃO INICIAL) ----
# Todas as senhas iniciais exigem troca no 1º acesso (must_change_password=1).
#
# EM PRODUÇÃO AS DUAS SÃO OBRIGATÓRIAS: se o banco estiver vazio e elas não
# estiverem definidas, o seed ABORTA a inicialização (instalação insegura
# bloqueada). Nenhum padrão conhecido é usado em produção.
# Bancos já inicializados nunca são alterados (o seed só roda com banco vazio).
#
# Em desenvolvimento/teste, se omitidas, usam os valores abaixo.
SEED_MASTER_PASSWORD=Master@2026
SEED_ANJOS_PASSWORD=Anjos@2026
